{
    "name": "@nextrap/<%= name %>",
    "version": "1.0.0",
    "files": [
        "*.*",
        "src",
        "skills"
    ],
    "main": "./index.js",
    "repository": {
        "directory": "<%= path %>",
        "type": "git",
        "url": "https://github.com/nextrap/nextrap-monorepo"
    },
    "peerDependencies": {
        "@nextrap/nt-core": "^2.0.0",
        "@nextrap/style-reset": "^2.0.0",
        "@trunkjs/browser-utils": "^1.0.12",
        "lit": "^3.3.1"
    },
    "devDependencies": {
        "@nextrap/style-base": "^1.0.0",
        "@nextrap/style-typography": "^1.0.0",
        "@nextrap/style-utils": "^1.0.0"
    },
    "type": "module",
    "types": "./index.d.ts",
    "web-types": "./web-types.json",
    "exports": {
        ".": {
            "sass": "./index.scss",
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./unstyled": {
            "types": "./unstyled.d.ts",
            "import": "./unstyled.js",
            "default": "./unstyled.js"
        },
        "./default": {
            "sass": "./default.scss",
            "default": "./default.scss"
        },
        "./*": "./*"
    },
    "sideEffects": true,
    "typesVersions": {
        "*": {
            "unstyled": [
                "unstyled.d.ts"
            ]
        }
    }
}
