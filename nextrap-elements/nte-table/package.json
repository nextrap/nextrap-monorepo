{
  "name": "@nextrap/nte-table",
  "version": "1.0.0",
  "files": [
    "*.*",
    "!ARCHITECTURE.md",
    ".ai-usage-info.md",
    "skills",
    "src"
  ],
  "main": "./index.js",
  "repository": {
    "directory": "nextrap-elements/nte-table",
    "type": "git",
    "url": "https://github.com/nextrap/nextrap-monorepo"
  },
  "type": "module",
  "types": "./index.d.ts",
  "web-types": "./web-types.json",
  "peerDependencies": {
    "@nextrap/nt-core": "^2.0.0",
    "@nextrap/style-reset": "^2.0.0",
    "lit": "^3.3.1"
  },
  "exports": {
    ".": {
      "sass": "./index.scss",
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./unstyled": {
      "types": "./unstyled.d.ts",
      "import": "./unstyled.js",
      "default": "./unstyled.js"
    },
    "./default": {
      "sass": "./default.scss",
      "default": "./default.scss"
    },
    "./*": "./*"
  },
  "sideEffects": true,
  "typesVersions": {
    "*": {
      "unstyled": [
        "unstyled.d.ts"
      ]
    }
  }
}
