{
    "name": "nte-code-editor",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "nextrap-elements/nte-code-editor/src",
    "projectType": "library",
    "tags": [],
    "release": {
        "version": {
            "currentVersionResolver": "disk",
            "preserveLocalDependencyProtocols": false,
            "manifestRootsToUpdate": [
                "{projectRoot}"
            ]
        }
    },
    "targets": {
        "build": {
            "executor": "@nx/vite:build",
            "outputs": [
                "{options.outputPath}"
            ],
            "defaultConfiguration": "production",
            "options": {
                "outputPath": "dist/nextrap-elements/nte-code-editor"
            },
            "configurations": {
                "development": {
                    "mode": "development"
                },
                "production": {
                    "mode": "production"
                }
            }
        },
        "nx-release-publish": {
            "executor": "@nx/js:release-publish",
            "options": {
                "packageRoot": "dist/nextrap-elements/nte-code-editor"
            }
        }
    }
}
