{
  "name": "@nextrap/nte-input",
  "version": "2.0.2",
  "main": "./index.js",
  "repository": {
    "directory": "nextrap-elements/nte-input",
    "type": "git",
    "url": "https://github.com/nextrap/nextrap-monorepo"
  },
  "dependencies": {},
  "devDependencies": {
    "@nextrap/nte-feedback": "^2.0.0",
    "@nextrap/style-base": "^2.0.0",
    "@nextrap/style-typography": "^2.0.0",
    "@nextrap/style-utils": "^2.0.0",
    "@trunkjs/form": "^1.0.0"
  },
  "type": "module",
  "types": "./index.d.ts",
  "web-types": "./web-types.json",
  "peerDependencies": {
    "@trunkjs/browser-utils": "^1.0.51",
    "lit": "^3.3.1",
    "@nextrap/nt-core": "^2.0.0",
    "@nextrap/style-reset": "^2.0.0"
  },
  "exports": {
    ".": {
      "sass": "./index.scss",
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./unstyled": {
      "types": "./unstyled.d.ts",
      "import": "./unstyled.js",
      "default": "./unstyled.js"
    },
    "./default": {
      "sass": "./default.scss",
      "default": "./default.scss"
    },
    "./*": "./*"
  },
  "sideEffects": true,
  "typesVersions": {
    "*": {
      "unstyled": [
        "unstyled.d.ts"
      ]
    }
  }
}
