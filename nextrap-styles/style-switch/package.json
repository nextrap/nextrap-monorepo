{
  "name": "@nextrap/style-switch",
  "version": "0.1.0",
  "description": "Accessible, composable CSS switch styles for Nextrap",
  "files": [
    "*.*",
    "src",
    ".agents"
  ],
  "main": "./index.js",
  "exports": {
    ".": {
      "sass": "./index.scss",
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./default": {
      "sass": "./default.scss",
      "default": "./default.scss"
    },
    "./unstyled": {
      "types": "./unstyled.d.ts",
      "import": "./unstyled.js",
      "default": "./unstyled.js"
    },
    "./*": "./*"
  },
  "repository": {
    "directory": "nextrap-styles/style-switch",
    "type": "git",
    "url": "https://github.com/nextrap/nextrap-monorepo"
  },
  "dependencies": {},
  "devDependencies": {},
  "type": "module",
  "types": "./index.d.ts",
  "sideEffects": true,
  "typesVersions": {
    "*": {
      "unstyled": [
        "unstyled.d.ts"
      ]
    }
  }
}
