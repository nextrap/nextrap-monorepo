{
  "name": "@nextrap/style-utils",
  "version": "2.0.0",
  "main": "./index.js",
  "repository": {
    "directory": "nextrap-base/style-utils",
    "type": "git",
    "url": "https://github.com/nextrap/nextrap-monorepo"
  },
  "exports": {
    ".": {
      "sass": "./index.scss",
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./default": {
      "sass": "./default.scss",
      "default": "./default.scss"
    },
    "./unstyled": {
      "types": "./unstyled.d.ts",
      "import": "./unstyled.js",
      "default": "./unstyled.js"
    },
    "./*": "./*"
  },
  "devDependencies": {
    "@nextrap/style-base": "^2.0.0"
  },
  "type": "module",
  "types": "./index.d.ts",
  "web-types": "./web-types.json",
  "sideEffects": true,
  "typesVersions": {
    "*": {
      "unstyled": [
        "unstyled.d.ts"
      ]
    }
  }
}
